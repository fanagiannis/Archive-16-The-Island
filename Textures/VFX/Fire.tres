[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, depth_prepass_alpha, unshaded;

uniform vec2 DisplacementSpeed;
uniform vec2 DisplacementScale = vec2(1.000000, 1.000000);
uniform sampler2D TextureDisplacement : source_color, repeat_enable;
uniform float DisplacementIntensity = 1.0;
uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D TextureBase : source_color, repeat_enable;
uniform sampler2D Texture_Add : source_color, hint_default_black, repeat_disable;
uniform sampler2D Texture_Substract : source_color, hint_default_black, repeat_disable;
uniform sampler2D Color_Pallete : source_color, hint_default_black, repeat_disable;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Vector2Parameter:8
	vec2 n_out8p0 = DisplacementSpeed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:10
	vec2 n_out10p0 = n_out8p0 * vec2(n_out9p0);


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out10p0 * n_in7p1 + UV;


// Vector2Parameter:11
	vec2 n_out11p0 = DisplacementScale;


// UVFunc:12
	vec2 n_in12p2 = vec2(0.00000, 0.00000);
	vec2 n_out12p0 = (n_out7p0 - n_in12p2) * n_out11p0 + n_in12p2;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(TextureDisplacement, n_out12p0);
	float n_out6p1 = n_out6p0.r;


// FloatParameter:17
	float n_out17p0 = DisplacementIntensity;


// FloatOp:16
	float n_out16p0 = n_out6p1 * n_out17p0;


// Input:14
	vec3 n_out14p0 = NORMAL;


// VectorOp:15
	vec3 n_out15p0 = vec3(n_out16p0) * n_out14p0;


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + n_out15p0;


// Output:0
	VERTEX = n_out3p0;


}

void fragment() {
// Vector2Parameter:5
	vec2 n_out5p0 = Speed;


// Input:6
	float n_out6p0 = TIME;


// VectorOp:7
	vec2 n_out7p0 = n_out5p0 * vec2(n_out6p0);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out7p0 * n_in4p1 + UV;


// Vector2Parameter:8
	vec2 n_out8p0 = Scale;


// UVFunc:9
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (n_out4p0 - n_in9p2) * n_out8p0 + n_in9p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(TextureBase, n_out9p0);
	float n_out3p1 = n_out3p0.r;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Texture_Add, UV);
	float n_out10p1 = n_out10p0.r;


// FloatOp:12
	float n_out12p0 = n_out3p1 + n_out10p1;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(Texture_Substract, UV);
	float n_out14p1 = n_out14p0.r;


// FloatOp:16
	float n_out16p0 = n_out12p0 - n_out14p1;


// Clamp:17
	float n_in17p1 = 0.00000;
	float n_in17p2 = 1.00000;
	float n_out17p0 = clamp(n_out16p0, n_in17p1, n_in17p2);


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Color_Pallete, vec2(n_out17p0));


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);
	ALPHA = n_out18p0.x;


}
