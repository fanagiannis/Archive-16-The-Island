[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D TextureBase : source_color, repeat_enable;
uniform sampler2D Texture_Add : source_color, hint_default_black, repeat_disable;
uniform sampler2D Texture_Substract : source_color, hint_default_black, repeat_disable;
uniform sampler2D Color_Pallete : source_color, hint_default_black, repeat_disable;



void fragment() {
// Vector2Parameter:6
	vec2 n_out6p0 = Speed;


// Input:7
	float n_out7p0 = TIME;


// VectorOp:8
	vec2 n_out8p0 = n_out6p0 * vec2(n_out7p0);


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out8p0 * n_in5p1 + UV;


// Vector2Parameter:9
	vec2 n_out9p0 = Scale;


// UVFunc:10
	vec2 n_in10p2 = vec2(0.00000, 0.00000);
	vec2 n_out10p0 = (n_out5p0 - n_in10p2) * n_out9p0 + n_in10p2;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(TextureBase, n_out10p0);
	float n_out4p1 = n_out4p0.r;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(Texture_Add, UV);
	float n_out11p1 = n_out11p0.r;


// FloatOp:13
	float n_out13p0 = n_out4p1 + n_out11p1;


	vec4 n_out14p0;
// Texture2D:14
	n_out14p0 = texture(Texture_Substract, UV);
	float n_out14p1 = n_out14p0.r;


// FloatOp:16
	float n_out16p0 = n_out13p0 - n_out14p1;


// Clamp:17
	float n_in17p1 = 0.00000;
	float n_in17p2 = 1.00000;
	float n_out17p0 = clamp(n_out16p0, n_in17p1, n_in17p2);


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Color_Pallete, vec2(n_out17p0));


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);


}
